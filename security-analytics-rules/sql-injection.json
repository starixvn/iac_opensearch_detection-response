      "/assets/", 
      "/public/", 
      "/cdn/", 
      "/images/", 
      "/img/", 
      "/css/", 
      "/js/", 
      "/fonts/", 
      "/media/"
    ]
  }, 
  "filter_api_endpoints": {
    "request_path|contains": [
      "/api/", 
      "/v1/", 
      "/v2/", 
      "/v3/", 
      "/health", 
      "/metrics", 
      "/status", 
      "/swagger/", 
      "/openapi/", 
      "/.well-known/", 
      "sha1:", 
      "md5:"
