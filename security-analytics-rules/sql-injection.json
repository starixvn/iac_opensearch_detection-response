  "filter_docker_registry": {
    "request_path|contains": [
      "/v2/", 
      "/manifests/", 
      "/blobs/", 
      "/tags/", 
      "_catalog", 
      "/uploads/", 
      "sha256:"
    ], 
    "user_agent|contains": [
      "docker/", 
      "containerd/", 
      "podman/", 
      "skopeo/", 
      "crane/", 
      "regctl/"
    ]
  }, 
  "sqli_union_based": {
    "request_path|contains": [
      "UNION SELECT", 
      "union select", 
      "UNION ALL SELECT", 
      "union all select", 
      "ORDER BY", 
      "order by", 
      "GROUP BY", 
      "group by", 
      "UNION%20SELECT", 
      "union%20select", 
      "UNION%20ALL%20SELECT", 
      "union%20all%20select", 
      "ORDER BY 1--", 
      "order by 1--", 
      "ORDER BY 2--", 
      "order by 2--", 
      "ORDER BY 3--", 
      "order by 3--", 
      "ORDER BY 1#", 
      "order by 1#", 
      "ORDER BY 2#", 
      "order by 2#", 
      "ORDER BY 3#", 
      "order by 3#"
    ]
  }, 
  "sqli_boolean_based": {
    "request_path|contains": [
      " OR 1=1--", 
      " OR 1=0--", 
      " OR 1=1#", 
      " OR 1=0#", 
      " OR x=x", 
      " OR x=y", 
      " AND true", 
      " AND false", 
      " HAVING 1=1", 
      " HAVING 1=0", 
      "' and 1=1--", 
      "' and 1=2--", 
      "' or 1=1--", 
      "' or 1=2--", 
      " WHERE 1=1", 
      " WHERE 1=0"
    ]
  }, 
  "filter_search_queries": {
    "http_referer|contains": [
      "/search", 
      "/find", 
      "/query"
    ], 
    "request_path|contains": [
      "/search", 
      "q=", 
      "query=", 
      "search=", 
      "keyword=", 
      "term=", 
      "find="
    ]
  }, 
  "sqli_numeric_based": {
    "request_path|contains": [
      "AND 1", 
      "AND 0", 
      "AND true", 
      "AND false"
    ]
  }
}